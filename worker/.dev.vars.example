# Local development only (`npx wrangler dev`).
# Copy to `.dev.vars` and fill in real values. `.dev.vars` is gitignored.
# In production these are set with `npx wrangler secret put <NAME>` instead.

APPS_SCRIPT_URL="https://script.google.com/macros/s/REPLACE_WITH_YOUR_DEPLOYMENT_ID/exec"

# Must match Script Property WEBHOOK_SECRET in Apps Script, character for character.
APPS_SCRIPT_SECRET="paste-the-WEBHOOK_SECRET-value-here"

# Must match Script Property TELEGRAM_WEBHOOK_SECRET and the secret_token
# registered with Telegram's setWebhook.
TELEGRAM_WEBHOOK_SECRET="paste-a-random-value-here"
